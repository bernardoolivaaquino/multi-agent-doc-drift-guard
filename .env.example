# Optional LLM provider settings (defaults to deterministic offline mode when unset)
DRIFT_GUARD_PROVIDER=deterministic
DRIFT_GUARD_MODEL=gpt-4o-mini

# Uncomment one of the keys below if running with a live LLM backend
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
